---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutOrbit from '@/components/AboutOrbit.astro';
import SocialIcons from '@/components/SocialIcons.astro';
import { site } from '@/data/site';
---

<BaseLayout title="关于" description="关于我。" wordBackground={false} defaultTheme="dark">
  <AboutOrbit name={site.name} tagline={site.tagline} />

  <section class="about-content wrap" id="about-story" aria-labelledby="about-story-title">
    <p class="eyebrow">A LITTLE ABOUT ME</p>
    <h2 id="about-story-title">一个把东西写下来的人。</h2>
    <p>我是{site.name}。{site.tagline}</p>
    <p>
      这个站点是我的数字花园：技术笔记、半成品项目、和一些还没想清楚的想法。
      没有评论区，因为我想让这里安静一点；想聊的话，邮件或者 GitHub 都能找到我。
    </p>

    <h2 class="section-title" id="about-now">现在</h2>
    <ol class="now-list">
      <li><span>01</span><div><h3>在写</h3><p>一些关于前端和工具链的笔记</p></div></li>
      <li><span>02</span><div><h3>在做</h3><p>几个自用的小工具，做完会放到<a href="/projects">作品</a>页</p></div></li>
      <li><span>03</span><div><h3>在读</h3><p>随手记在笔记里，值得的会整理成文章</p></div></li>
    </ol>

    <h2 class="section-title" id="about-contact">联系我</h2>
    <SocialIcons />
  </section>
</BaseLayout>

<style>
  .about-content { max-width: 800px; padding-top: 100px; padding-bottom: 56px; }
  .about-content .eyebrow { font-size: 11px; letter-spacing: .22em; }
  .about-content h2 { font-size: clamp(30px, 3.3vw, 40px); font-weight: 400; line-height: 1.3; margin: 20px 0 35px; }
  .about-content > p:not(.eyebrow) { color: var(--fg-soft); line-height: 2; margin: 0 0 18px; }
  .about-content .section-title { font-size: 22px; margin: 68px 0 24px; }
  .now-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .now-list li { display: flex; gap: 36px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .now-list li > span { flex: 0 0 25px; padding-top: 4px; color: var(--accent); font-family: var(--font-ui); font-size: 12px; }
  .now-list h3 { margin: 0 0 6px; font-size: 17px; font-weight: 400; }
  .now-list p { margin: 0; color: var(--fg-soft); font-size: 14px; }
  @media (max-width: 640px) {
    .about-content { padding-top: 60px; }
    .now-list li { gap: 22px; }
  }
</style>
