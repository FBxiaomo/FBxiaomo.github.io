---
import cms from '../../../cms.config.json';
import source from '../../../blog-source.config.json';
import { createCmsConfig } from '../../../scripts/cms-config.mjs';

const config = createCmsConfig({ source, cms });
const ready = Boolean(cms.oauthBaseUrl);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>写作后台 · 风暴小末</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    {!ready && <main class="pending"><h1>写作后台准备中</h1><p>登录服务连接完成后，即可在这里管理文章。</p><a href="/blog/">返回博客 →</a></main>}
    {ready && <>
      <div id="cms"></div>
      <aside class="status" aria-live="polite"><span id="publish-status">保存后会自动更新网站；删除文章后请点“更新网站”。</span><button id="publish-site" type="button">更新网站</button></aside>
      <script is:inline>window.CMS_MANUAL_INIT = true;</script>
      <script is:inline src="https://cdn.jsdelivr.net/npm/decap-cms@3.16.3/dist/decap-cms.js"></script>
      <script is:inline define:vars={{ config, proxyUrl: config.backend.base_url }}>
        (function () {
          const status = document.getElementById('publish-status');
          const button = document.getElementById('publish-site');
          let busy = false;
          async function publishSite() {
            if (busy) return;
            let user;
            try { user = JSON.parse(localStorage.getItem('decap-cms-user') || 'null'); } catch {}
            if (!user?.token) { status.textContent = '请先登录，再更新网站。'; return; }
            busy = true;
            button.disabled = true;
            status.textContent = '正在启动网站更新…';
            try {
              const response = await fetch(proxyUrl + '/publish', { method: 'POST', headers: { Authorization: 'Bearer ' + user.token } });
              const result = await response.json();
              status.textContent = response.ok ? result.message : (result.error || '文章已保存，网站更新未启动，请稍后重试。');
            } catch { status.textContent = '文章已保存，暂时无法启动网站更新，可稍后重试。'; }
            finally { busy = false; button.disabled = false; }
          }
          button.addEventListener('click', publishSite);
          if (!window.CMS) { status.textContent = '编辑器暂时无法加载，请刷新页面重试。'; return; }
          CMS.registerEventListener({ name: 'postSave', handler: publishSite });
          CMS.init({ config });
        })();
      </script>
    </>}
    <style>
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif; }
      .pending { margin: 15vh auto; max-width: 480px; padding: 32px; color: #332c26; }
      .pending h1 { font-size: 28px; }
      .pending p { color: #6b635a; line-height: 1.8; }
      .pending a { color: #b04a2f; text-decoration: none; }
      .status { position: fixed; z-index: 9999; bottom: 16px; right: 16px; left: auto; max-width: min(500px, calc(100vw - 32px)); display: flex; align-items: center; gap: 12px; padding: 12px 16px; border: 1px solid #e8ded0; border-radius: 12px; background: #fffaf3; box-shadow: 0 4px 20px #0001; font-size: 13px; line-height: 1.6; }
      .status button { border: 0; border-radius: 8px; padding: 8px 12px; background: #b04a2f; color: white; white-space: nowrap; cursor: pointer; }
      .status button:disabled { opacity: .5; }
    </style>
  </body>
</html>
