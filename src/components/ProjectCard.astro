---
import type { Project } from '@/data/projects';

interface Props { project: Project; }
const { project } = Astro.props;
const isExternal = project.external ?? /^https?:\/\//.test(project.href);
const statusLabel = { active: '维护中', wip: '开发中', archived: '已归档' } as const;
---

<a
  class="card"
  href={project.href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  {project.cover && (
    <div class="card-cover">
      <img src={project.cover} alt={project.name + ' 封面'} loading="lazy" />
    </div>
  )}
  <div class="card-head">
    <h3 class="card-title">{project.name}</h3>
    {isExternal && (
      <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7M9 7h8v8"/>
      </svg>
    )}
  </div>
  <p class="card-desc">{project.desc}</p>
  {project.tags && project.tags.length > 0 && (
    <div class="card-meta">
      {project.tags.map((t) => <span class="tag">{t}</span>)}
      {project.status && <span class="status" data-status={project.status}>{statusLabel[project.status]}</span>}
    </div>
  )}
</a>

<style>
  .card-cover {
    margin: -20px -20px 4px;
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
    background: var(--bg-soft);
  }
  .card-cover img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    display: block;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: var(--shadow);
    color: var(--fg);
    transition: transform .18s cubic-bezier(.22,.61,.36,1), border-color .18s ease, box-shadow .18s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 4px 8px rgba(60,40,20,.07), 0 14px 32px rgba(60,40,20,.08);
    text-decoration: none;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .card-title {
    margin: 0;
    font-size: 16.5px;
    font-weight: 700;
    letter-spacing: .01em;
  }

  .arrow {
    flex-shrink: 0;
    color: var(--fg-faint);
    transition: color .18s ease, transform .18s ease;
  }
  .card:hover .arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .card-desc {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--fg-soft);
    font-family: var(--font-ui);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
    font-family: var(--font-ui);
  }

  .tag {
    font-size: 11.5px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--fg-soft);
    border: 1px solid var(--line);
  }

  .status {
    font-size: 11.5px;
    padding: 2px 8px;
    border-radius: 999px;
    margin-left: auto;
  }
  .status[data-status='active'] { color: #2f7d4f; background: #e6f4ec; }
  .status[data-status='wip'] { color: #a56a13; background: #fbf0dc; }
  .status[data-status='archived'] { color: var(--fg-faint); background: var(--bg-soft); }

  :global([data-theme='dark']) .status[data-status='active'] { color: #7fc99b; background: #1c2f24; }
  :global([data-theme='dark']) .status[data-status='wip'] { color: #d9ac5f; background: #322818; }
</style>
