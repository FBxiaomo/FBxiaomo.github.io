---
import { site } from '@/data/site';

const path = Astro.url.pathname;
const nav = [
  { label: '首页', href: '/' },
  { label: '作品', href: '/projects' },
  { label: '博客', href: '/blog' },
  { label: '关于', href: '/about' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <span class="dot"></span>
      <span>{site.brand}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深浅色">
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
      </svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
      </svg>
    </button>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });

  // 页面滚到深色区块上时，导航跟着变深，避免毛玻璃糊成一片灰
  const header = document.querySelector('.site-header');
  const darkSections = [...document.querySelectorAll('.band')];
  const HDR = 60;
  let ticking = false;

  function syncHeader() {
    ticking = false;
    if (!header) return;
    const over = darkSections.some((el) => {
      const r = el.getBoundingClientRect();
      return r.top <= HDR && r.bottom > 0;
    });
    header.classList.toggle('over-dark', over);
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(syncHeader);
  }

  syncHeader();
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', syncHeader, { passive: true });
  addEventListener('load', syncHeader);
  // 字体 / 布局落定后再校正一次
  setTimeout(syncHeader, 250);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .site-header.over-dark {
    background: color-mix(in srgb, var(--bg-band) 78%, transparent);
    border-bottom-color: rgba(255, 255, 255, .08);
  }
  .site-header.over-dark .brand { color: #f1eae0; }
  .site-header.over-dark .nav-link { color: #b3a99b; }
  .site-header.over-dark .nav-link:hover { color: #f1eae0; background: rgba(255, 255, 255, .08); }
  .site-header.over-dark .nav-link.active { color: #e8a07c; background: rgba(224, 138, 99, .16); }
  .site-header.over-dark .theme-toggle { color: #e6ddd0; border-color: rgba(255, 255, 255, .16); }
  .site-header.over-dark .theme-toggle:hover { color: #e8a07c; border-color: #e8a07c; background: rgba(224, 138, 99, .14); }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 60px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 16px;
    color: var(--fg);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .brand:hover { text-decoration: none; }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .nav-link {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--fg-soft);
    padding: 6px 11px;
    border-radius: 8px;
    transition: all .15s ease;
  }
  .nav-link:hover {
    color: var(--fg);
    background: var(--bg-soft);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: transparent;
    color: var(--fg-soft);
    cursor: pointer;
    transition: all .15s ease;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  :global([data-theme='light']) .icon-moon,
  :global([data-theme='dark']) .icon-sun { display: none; }

  @media (max-width: 620px) {
    .header-inner { gap: 10px; }
    .brand span:last-child { display: none; }
    .nav-link { padding: 6px 8px; font-size: 13px; }
  }
</style>
