---
import SocialIcons from '@/components/SocialIcons.astro';
import { site } from '@/data/site';

const lines = site.tagline.split('，');
const first = lines[0] ?? site.tagline;
const rest = lines.slice(1).join('，');
---

<section class="hero">
  <div class="wrap">
    <p class="eyebrow rv">你好，我是 {site.name}</p>

    <h1 class="display rise">
      <span><i>{first}{rest ? '，' : ''}</i></span>
      <span><i>{rest || site.tagline}</i></span>
    </h1>

    <p class="lead rv" style="--i:2">{site.intro}</p>

    <div class="cta rv" style="--i:3">
      <a class="pill primary" href="/blog" data-magnet>读点东西 <span aria-hidden="true">→</span></a>
      <a class="pill ghost" href="/projects" data-magnet>看看作品</a>
    </div>

    <div class="rv socials" style="--i:4">
      <SocialIcons />
    </div>
  </div>

  <div class="scroll-hint rv" style="--i:6" aria-hidden="true">
    <span>向下</span>
    <i></i>
  </div>
</section>

<style>
  .hero {
    padding: 124px 0 96px;
    position: relative;
  }

  .display { max-width: 15ch; }

  .dot { color: var(--accent); }

  .lead {
    margin: 28px 0 0;
    max-width: 30em;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    border-radius: 980px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    transition: transform .3s var(--ease), background-color .2s ease, border-color .2s ease, box-shadow .25s ease;
    will-change: transform;
  }
  .pill:hover { text-decoration: none; }

  .pill.primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .pill.primary:hover { filter: brightness(1.07); box-shadow: 0 10px 28px color-mix(in srgb, var(--accent) 34%, transparent); }

  .pill.ghost {
    border: 1px solid var(--line);
    color: var(--fg);
    background: transparent;
  }
  .pill.ghost:hover { background: var(--bg-soft); border-color: var(--accent); }

  .socials { margin-top: 34px; }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: .22em;
    color: var(--fg-faint);
  }
  .scroll-hint i {
    width: 1px;
    height: 26px;
    background: linear-gradient(to bottom, var(--line), transparent);
    position: relative;
    overflow: hidden;
  }
  .scroll-hint i::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: drop 2.2s var(--ease) infinite;
  }
  @keyframes drop {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint i::after { animation: none; opacity: .4; }
  }

  @media (max-width: 640px) {
    .hero { padding: 88px 0 64px; }
    .display { max-width: none; }
    .scroll-hint { display: none; }
  }
</style>
